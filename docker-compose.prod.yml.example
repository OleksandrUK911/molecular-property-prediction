# Template for a production deployment. This project has no real
# production hosting yet (see README's "Status" section) - these values
# are illustrative placeholders, not real URLs. Copy this file to
# docker-compose.prod.yml (gitignored, or keep it out of git entirely)
# and fill in the actual production domain before use. Run with:
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml up --build
#
# Same two knobs as staging, pointed at the production origin instead:
# CORS_ALLOWED_ORIGINS restricts the backend to the real prod frontend
# origin, and VITE_API_BASE_URL bakes the real prod backend URL into the
# frontend build (VITE_* vars are compiled in at build time, not read at
# container runtime - see frontend/Dockerfile).
services:
  backend:
    environment:
      CORS_ALLOWED_ORIGINS: https://example-prod-domain.com

  frontend:
    build:
      args:
        VITE_API_BASE_URL: https://api.example-prod-domain.com
