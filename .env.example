VITE_API_BASE_URL=http://localhost:8000

# Comma-separated list of origins the backend's CORS middleware allows.
# Read by backend/app/main.py; falls back to the local-dev defaults below
# if unset, so leaving this unset keeps `docker compose up` working exactly
# as before. Override per-environment - see docker-compose.staging.yml.example
# and docker-compose.prod.yml.example for how staging/prod would set it.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
